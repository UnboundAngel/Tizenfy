{
  "name": "@unboundangel/tizenspotify",
  "version": "1.0.3",
  "description": "Ad-free Spotify for Samsung Tizen TVs via TizenBrew",
  "packageType": "mods",
  "websiteURL": "https://open.spotify.com",
  "main": "userScript.js",
  "serviceFile": "service.js",
"keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "appName": "Tizenfy",
  "author": "UnboundAngel",
  "license": "GPL-3.0"
}
